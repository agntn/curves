{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-curves",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://curves.agntn.dev"
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-curves",
      "database_id": "8f69127c-e0e4-4b81-accd-55492ff2a2d7"
    }
  ],
  "routes": [{ "pattern": "curves.agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "previews": {
    "vars": {
      "NUXT_SITE_URL": "https://curves.agntn.dev"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "1e329db6-3e09-4001-86c6-bb45981de62a"
      }
    ]
  }
}
