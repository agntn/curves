{
  "name": "@agntn/curves",
  "version": "0.0.0",
  "description": "Arithmetic on elliptic curves you define and on secp256k1, written from the specs",
  "keywords": [
    "agent",
    "bitcoin",
    "discrete-log",
    "ecc",
    "elliptic-curve",
    "mcp",
    "sec1",
    "secp256k1",
    "weierstrass"
  ],
  "homepage": "https://github.com/agntn/curves#readme",
  "bugs": "https://github.com/agntn/curves/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/curves.git"
  },
  "bin": {
    "curves": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/omp/extensions",
    "packages/pi/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./secp256k1": {
      "types": "./dist/secp256k1.d.mts",
      "import": "./dist/secp256k1.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "fmt": "pnpm build && vp lint --fix && vp fmt",
    "typecheck": "tsc --noEmit --skipLibCheck && pnpm build && tsc -p tsconfig.extensions.json && tsc -p test/tsconfig.json",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "prepack": "pnpm run build",
    "release": "pnpm build && pnpm test && changelogen --release --push"
  },
  "dependencies": {
    "@agntn/tools": "0.1.1",
    "@modelcontextprotocol/server": "2.2.0",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "scule": "1.3.0"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@modelcontextprotocol/client": "2.2.0",
    "@oh-my-pi/pi-coding-agent": "18.0.0",
    "@types/node": "26.2.0",
    "ai": "7.0.66",
    "changelogen": "0.6.2",
    "obuild": "0.4.43",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.22.0",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/curves.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/curves.ts"
    ]
  }
}
